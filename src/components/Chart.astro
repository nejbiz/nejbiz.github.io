---
interface Props {
  data: number[];
  labels?: string[];
  type?: 'bar' | 'line' | 'doughnut';
  height?: number;
}

const { data, labels, type = 'bar', height = 300 } = Astro.props;
const chartId = `chart-${Math.random().toString(36).slice(2, 8)}`;
---
<div class="chart-wrapper" style={`height: ${height}px`}>
  <canvas id={chartId}></canvas>
</div>

<script is:inline define:vars={{ chartId, data, labels, type }}>
  import('https://cdn.jsdelivr.net/npm/chart.js@4/+esm').then(({ Chart, registerables }) => {
    Chart.register(...registerables);
    new Chart(document.getElementById(chartId), {
      type,
      data: {
        labels: labels ?? data.map((_, i) => String(i + 1)),
        datasets: [{ data, borderWidth: 1, fill: false }],
      },
      options: { responsive: true, maintainAspectRatio: false },
    });
  });
</script>
